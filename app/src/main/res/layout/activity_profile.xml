<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="40dp"
                android:text="User Profile"
                android:textColor="#7F00FF"
                android:textSize="28sp"
                android:textStyle="bold"
                />

            <ImageView
                android:id="@+id/ivProfileIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_below="@id/tvTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="25dp"
                android:src="@drawable/account_icon" />

            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="340dp"
                android:layout_height="250dp"
                android:layout_below="@id/ivProfileIcon"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_rounded_grey"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/account_icon"
                        app:tint="#7F00FF"
                        android:contentDescription="User Icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="USERNAME"
                        android:textColor="#7F00FF"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etProfileUsername"
                    android:layout_width="316dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_white"
                    android:enabled="false"
                    android:paddingHorizontal="15dp"
                    android:textColor="#000000"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email_purple"
                        android:contentDescription="Email Icon" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="EMAIL"
                        android:textColor="#7F00FF"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etProfileEmail"
                    android:layout_width="316dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_white"
                    android:enabled="false"
                    android:paddingHorizontal="15dp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="223dp"
                android:layout_height="40dp"
                android:layout_below="@id/infoContainer"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:backgroundTint="#7F00FF"
                android:text="Edit Profile"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="223dp"
                android:layout_height="40dp"
                android:layout_below="@id/btnEditProfile"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#E6E6E6"
                android:text="Sign Out"
                android:textAllCaps="false"
                android:textColor="#7F00FF"
                android:textStyle="bold"/>

        </RelativeLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:background="#25AD7FCC"
        app:elevation="8dp"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="30dp"
        app:itemIconTint="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
