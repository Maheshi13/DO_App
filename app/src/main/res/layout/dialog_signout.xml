<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="348dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_shadow"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Really want to sign out?"
        android:textColor="#7F00FF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="You'll need to log in again to access your account and all your tasks."
        android:textColor="#000000"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#7F00FF"
            app:cornerRadius="12dp"
            app:strokeColor="#7F00FF"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="32dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnConfirmSignOut"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="#FF0000"
            app:cornerRadius="12dp"
            app:strokeColor="#FF0000"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>